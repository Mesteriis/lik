<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="210dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="3dp">
  <LinearLayout android:id="@+id/period_images" android:layout_width="match_parent"
      android:layout_height="match_parent" android:orientation="horizontal">
    <ImageView android:id="@+id/period_cover" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:background="@color/lik_surface" android:contentDescription="@null" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/period_sample_2" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:background="@color/lik_surface" android:contentDescription="@null" android:scaleType="centerCrop" android:visibility="gone" />
    <ImageView android:id="@+id/period_sample_3" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:background="@color/lik_surface" android:contentDescription="@null" android:scaleType="centerCrop" android:visibility="gone" />
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="96dp"
      android:layout_gravity="bottom" android:background="@drawable/lik_period_scrim" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_gravity="bottom" android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/period_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="20sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/period_count" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:textColor="#E6FFFFFF" android:textSize="14sp" />
  </LinearLayout>
</FrameLayout>
