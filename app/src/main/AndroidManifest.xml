    </activity-alias>
    <activity-alias
        android:name=".launcher.Sapphire"
        android:enabled="false"
        android:exported="true"
        android:icon="@mipmap/ic_launcher_sapphire"
        android:label="@string/app_name"
        android:targetActivity=".ui.MainActivity">
      <intent-filter>
